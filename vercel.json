{
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/script.js", "destination": "/frontend/script.js" },
    { "source": "/Images/:path*", "destination": "/frontend/Images/:path*" },
    { "source": "/pages/:path*", "destination": "/frontend/pages/:path*" },
    { "source": "/zodiacs", "destination": "/api/zodiacs" },
    { "source": "/zodiacs/birthday", "destination": "/api/zodiacs" },
    { "source": "/zodiacs/search", "destination": "/api/zodiacs" }
  ]
}
